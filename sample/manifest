title=CleverTap Roku Sample
major_version=1
minor_version=0
build_version=0

ui_resolutions=fhd

# Channel art: CleverTap logo on brand red. Focus icon shows in the Roku home grid, the
# splash shows while the channel loads.
mm_icon_focus_hd=pkg:/images/channel-poster-hd.png
mm_icon_focus_fhd=pkg:/images/channel-poster-fhd.png
splash_screen_hd=pkg:/images/splash-hd.png
splash_screen_fhd=pkg:/images/splash-fhd.png
splash_color=#EF4444

# CleverTap credentials can live here instead of being passed to init(). Fill these in (or pass
# them to callfunc("init", {...}) in MainScene.brs) before sideloading.
clevertap_account_id=YOUR_ACCOUNT_ID
clevertap_token=YOUR_TOKEN
clevertap_region=in1
