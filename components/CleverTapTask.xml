<?xml version="1.0" encoding="utf-8" ?>
<!-- Background worker node. Roku forbids network calls on the render thread, so all the
     HTTP work (domain handshake + uploading batches) happens here on its own thread.
     Results are written back to fields the main node observes. -->
<component name="CleverTapTask" extends="Task">
    <interface>
        <!-- The batch payload to upload and the config it needs; set by the main node. -->
        <field id="request" type="assocarray" />
        <!-- Result the main node reads after the upload finishes. -->
        <field id="response" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="CleverTapTask.brs" />
    <!-- SceneGraph components don't inherit pkg:/source automatically, so pull in the
         shared helpers this node calls. -->
    <script type="text/brightscript" uri="pkg:/source/CleverTapConstants.brs" />
    <script type="text/brightscript" uri="pkg:/source/CleverTapLog.brs" />
    <script type="text/brightscript" uri="pkg:/source/CleverTapNetwork.brs" />
    <script type="text/brightscript" uri="pkg:/source/CleverTapRequest.brs" />
    <!-- CleverTapRequest reports a key spelled in the wrong letter case, and that check
         lives in CleverTapValidator. -->
    <script type="text/brightscript" uri="pkg:/source/CleverTapValidator.brs" />
    <!-- CleverTapRequest converts every event property, and that conversion lives in
         CleverTapValue. -->
    <script type="text/brightscript" uri="pkg:/source/CleverTapValue.brs" />
    <!-- The reply carries the block of values the server asks the SDK to repeat, and reading
         it out lives in CleverTapArp. -->
    <script type="text/brightscript" uri="pkg:/source/CleverTapArp.brs" />
</component>
